<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <service
      android:name="app.upeer.transport.YggdrasilTransportService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:process=":yggdrasil"
      android:stopWithTask="false">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="User-requested persistent peer-to-peer communication session using the Yggdrasil overlay; requires an ongoing visible connection notification and user disconnect control" />
    </service>
  </application>
</manifest>
