package app.upeer.transport;

interface IYggdrasilTransport {
  String startWithPeers(String peersJSON, in byte[] seed);
  String start(in byte[] configJSON);
  String nodeInfo();
  String deriveIdentity(in byte[] seed);
  byte[] generateNodeSeed();
  void stop();
  void ensureForeground();
  String peerStatusJSON();
  String peerPoolJSON();
  long connectedPeerCount();
  void retryPeers();
  int dialTCP(String address, int port);
  int dialUDP(String address, int port);
  void write(int connectionID, in byte[] payload);
  void writeDatagram(int connectionID, in byte[] payload);
  void closeConnection(int connectionID);
  byte[] read(int connectionID, int maxBytes, int timeoutMillis);
  int listenTCP(int port);
  int acceptTCP(int listenerID, int timeoutMillis);
  void closeListener(int listenerID);
  byte[] readFrame(int connectionID, int timeoutMillis);
  void writeFrame(int connectionID, in byte[] payload);
  String validateControlFrame(in byte[] payload);
  String inboundStatusJSON();
  void setIdentity(in byte[] secretKey);
  void clearIdentity();
  String identityStatusJSON();
  String sendChat(String upeerId, String content, String replyTo);
  int editChat(String upeerId, String messageId, String content);
  String messagesJSON(String upeerId, int limit);
  String conversationsJSON();
  String peerSecurityJSON(String upeerId);
  void markConversationRead(String upeerId);
  void sendTyping(String upeerId);
  void sendReaction(String upeerId, String messageId, String emoji, boolean remove);
  void deleteMessage(String upeerId, String messageId);
  boolean deleteConversation(String upeerId);
  void setBlockedPeers(String blockedJSON);
  void setKnownContacts(String knownJSON);
  void setNotificationPrefs(String prefsJSON);
  void setReadReceipts(boolean enabled);
  void setMutedPeers(String mutedJSON);
  boolean registerPeer(String upeerId, String address, String publicKey, String signedPreKeyJSON);
  void flushOutbox();
  String protocolStatusJSON();
  String locationBlockJSON(long ttlMillis);
  String deviceIdentityStatusJSON();
  String dhtLocationStatusJSON();
  String lookupContactLocation(String upeerId);
  String accountRegistryJSON();
  String accountRegistryStatusJSON();
  String revokeAccountDevice(String deviceId, String reason);
  boolean validateDeviceAdmission(String certificateJSON, String registryJSON, String expectedAccountUpeerId, long nowMillis);
  boolean verifyLocationBlock(String blockJSON, String publicKeyHex, long nowMillis);
  String deviceEnrollmentBegin(String code);
  String deviceEnrollmentRequestJSON();
  String deviceEnrollmentFinish(String sealedResponse);
  void deviceEnrollmentCancel();
  String deviceEnrollmentStatusJSON();
  String enrollmentAuthorizerCreateInvite(long ttlMillis);
  String enrollmentAuthorizerAcceptRequest(String requestCode);
  String enrollmentAuthorizerComplete(String enrollmentJSON, long ttlMillis);
  String enrollmentAuthorizerStatusJSON();
  void enrollmentAuthorizerCancel(String inviteId);
  void enrollmentAuthorizerCancelAll();
}
