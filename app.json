{
  "expo": {
    "name": "uPeer",
    "slug": "upeer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "upeer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.upeer.upeer"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "uPeer usa la cámara para escanear los códigos de vinculación de dispositivos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "uPeer accede a tus fotos para enviarlas por el chat.",
          "savePhotosPermission": "uPeer guarda en tu galería las fotos que recibes.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-sharing",
      "./plugins/with-commons-io-version",
      [
        "expo-audio",
        {
          "microphonePermission": "uPeer usa el micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "uPeer usa Face ID para desbloquear la app."
        }
      ]
    ],
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
